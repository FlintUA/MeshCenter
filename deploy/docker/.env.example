# Copy to .env next to compose.yaml. Non-secret values only.

# Owner of the ./data and ./config folders on the host (Synology: `id <user>`).
PUID=1026
PGID=100

# Time zone for the clock and the schedule engine (IANA name).
TZ=Europe/Berlin

# Shown in the UI; set it to the image tag you build (e.g. `git describe`).
MESHCENTER_VERSION=dev

# Trust the host's clock as NTP-synchronized. A container has no timedatectl,
# so without this the schedule engine and the radio time sync stay off.
# DSM keeps the NAS clock synchronized by default; set 0 if yours is not.
MESHCENTER_TRUST_HOST_CLOCK=1

# Optional: name of this installation (default: "MeshCenter <hostname>").
# MESHCENTER_INSTANCE_NAME=MeshCenter NAS
