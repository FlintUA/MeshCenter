#!/bin/sh
# MeshCenter repository guard for pushes: refuse archives and files over 5 MB in the commits being pushed.
# Switch on once per clone:  git config core.hooksPath scripts/git-hooks
root="$(git rev-parse --show-toplevel)"
if python3 -c '' >/dev/null 2>&1; then py=python3; elif python -c '' >/dev/null 2>&1; then py=python; else py=py; fi  # python3 can be a Windows Store stub
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="origin/main..$local_sha"; else range="$remote_sha..$local_sha"; fi
  git rev-parse --verify -q "${range%%..*}" >/dev/null || range="$local_sha~1..$local_sha"
  "$py" "$root/scripts/check_no_large_files.py" --range "$range" || status=1
done
exit $status
